<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Picator.GameV2.Views.Components.PulsingDots"
             x:Name="this">
    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
        <Ellipse x:Name="Dot1" WidthRequest="6" HeightRequest="6" Fill="{Binding DotColor, Source={x:Reference this}}" Opacity="0.25" Scale="0.8" />
        <Ellipse x:Name="Dot2" WidthRequest="6" HeightRequest="6" Fill="{Binding DotColor, Source={x:Reference this}}" Opacity="0.25" Scale="0.8" />
        <Ellipse x:Name="Dot3" WidthRequest="6" HeightRequest="6" Fill="{Binding DotColor, Source={x:Reference this}}" Opacity="0.25" Scale="0.8" />
    </HorizontalStackLayout>
</ContentView>
