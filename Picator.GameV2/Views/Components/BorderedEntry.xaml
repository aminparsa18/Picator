<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="Picator.Game.Controls.BorderedEntry"
             x:Name="this">
    <ContentView.Content>
        <VerticalStackLayout>
            <Grid>
                <Border x:Name="EntryBorder" BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource InkStrongBrush}" StrokeThickness="2" StrokeShape="RoundRectangle 12" HeightRequest="48" Padding="0">
                    <Entry
                        x:Name="EntryControl"
                           IsPassword="{Binding IsPassword, Source={x:Reference this}}"
                           MaxLength="{Binding MaxLength, Source={x:Reference this}}"
                           Keyboard="{Binding Keyboard, Source={x:Reference this}}"
                           Text="{Binding Text, Source={x:Reference this}}"
                           TextColor="{StaticResource InkStrong}"
                           BackgroundColor="Transparent"
                           Focused="EntryControl_Focused"
                           Unfocused="EntryControl_Unfocused">
                    </Entry>
                </Border>
                <Label x:Name="PlaceHolderLabel" Text="{Binding Placeholder, Source={x:Reference this}}" FontSize="13" Margin="16,0" VerticalOptions="Center" TextColor="{StaticResource InkFaint}"/>

            </Grid>
            <Label x:Name="ErrorLabel" Margin="16,0" IsVisible="False" FontSize="10" TextColor="{StaticResource Error}"/>
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>
    </ContentView.Content>
</ContentView>