<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="Picator.Game.Controls.BorderedEntry"
             x:Name="this">
    <ContentView.Content>
        <VerticalStackLayout>
            <Grid>
                <Border x:Name="EntryBorder" BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource InkStrongBrush}" StrokeThickness="2" StrokeShape="RoundRectangle 12" HeightRequest="48" Padding="0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry
                            x:Name="EntryControl" Grid.Column="0" Margin="8,0,0,0"
                               IsPassword="{Binding IsPassword, Source={x:Reference this}}"
                               MaxLength="{Binding MaxLength, Source={x:Reference this}}"
                               Keyboard="{Binding Keyboard, Source={x:Reference this}}"
                               Text="{Binding Text, Source={x:Reference this}}"
                               FontFamily="PatrickHandRegular"
                               TextColor="{StaticResource InkStrong}"
                               BackgroundColor="Transparent"
                               Focused="EntryControl_Focused"
                               Unfocused="EntryControl_Unfocused">
                        </Entry>
                        <Label x:Name="ToggleShowPasswordLabel" Grid.Column="1" Text="show"
                               IsVisible="{Binding IsPassword, Source={x:Reference this}}"
                               FontFamily="PatrickHandRegular" FontSize="13" TextColor="{StaticResource InkMuted}"
                               VerticalOptions="Center" Margin="0,0,14,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ToggleShowPasswordLabel_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
                <Label x:Name="PlaceHolderLabel" Text="{Binding Placeholder, Source={x:Reference this}}" FontFamily="PatrickHandRegular" FontSize="13" Margin="16,0" VerticalOptions="Center" TextColor="{StaticResource InkFaint}"/>

            </Grid>
            <Label x:Name="ErrorLabel" Margin="16,0" IsVisible="False" FontFamily="PatrickHandRegular" FontSize="10" TextColor="{StaticResource Error}"/>
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>
    </ContentView.Content>
</ContentView>