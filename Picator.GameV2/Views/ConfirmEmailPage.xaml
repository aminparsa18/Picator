<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Picator.Game.ViewModels"
             xmlns:controls="clr-namespace:Picator.Game.Controls"
             NavigationPage.HasNavigationBar="False"
             x:Class="Picator.Game.Views.ConfirmEmailPage">
    <ContentPage.BindingContext>
        <viewmodels:ConfirmEmailViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout>
            <Image Source="logo_text.png" x:Name="Logo" Margin="0,16,0,16" WidthRequest="72" />
            <controls:BorderedEntry Text="{Binding Code.Value}" MaxLength="6"
                                    Placeholder="Enter your verification code"
                                    Keyboard="Numeric" />
            <Button Text="Continue" Command="{Binding ConfirmCommand}" Margin="24" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>