<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Picator.Game.Models"
             xmlns:controls="clr-namespace:Picator.Game.Controls"
             xmlns:viewmodels="clr-namespace:Picator.Game.ViewModels"
             xmlns:svg="https://vapolia.eu/svg"
             x:Class="Picator.Game.Views.ProfileSettingsPage"
             x:DataType="viewmodels:ProfileSettingsViewModel"
             BackgroundColor="{StaticResource PaperBackground}"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.BindingContext>
        <viewmodels:ProfileSettingsViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <Grid>

            <controls:DotGridBackground DotColor="{StaticResource BorderHairline}" Spacing="18" DotRadius="1" />

            <ScrollView>
                <VerticalStackLayout Margin="22,36,22,32" Spacing="26">

                    <!--Header-->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border WidthRequest="38" HeightRequest="38" Padding="0"
                                StrokeShape="RoundRectangle 19" Stroke="{StaticResource InkStrong}" StrokeThickness="2"
                                BackgroundColor="{StaticResource Surface}">
                            <Label Text="&#8592;" FontFamily="PatrickHandRegular" FontSize="18" TextColor="{StaticResource InkStrong}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Label Grid.Column="1" Text="Profile" FontFamily="KalamBold" FontSize="22"
                               TextColor="{StaticResource InkStrong}" VerticalOptions="Center" Margin="14,0,0,0" />
                    </Grid>

                    <!--Avatar-->
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Grid WidthRequest="96" HeightRequest="96">
                            <Border WidthRequest="96" HeightRequest="96" Padding="6" StrokeShape="RoundRectangle 48"
                                    Stroke="{StaticResource InkStrong}" StrokeThickness="3" BackgroundColor="{StaticResource Surface}">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource InkStrongBrush}" Opacity="0.9" Radius="0" Offset="3,3" />
                                </Border.Shadow>
                                <Image x:Name="CachedImage" Aspect="AspectFit" Source="{Binding Image}" />
                            </Border>
                            <Border WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 17"
                                    Stroke="{StaticResource InkStrong}" StrokeThickness="2" BackgroundColor="{StaticResource Surface}"
                                    HorizontalOptions="End" VerticalOptions="End" TranslationX="4" TranslationY="4">
                                <Label Text="&#9998;" FontSize="15" TextColor="{StaticResource InkStrong}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAvatarPickerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                        <Label Text="Tap the pencil to change your avatar" FontFamily="PatrickHandRegular" FontSize="14"
                               TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>

                    <!--Display Name-->
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource InkStrong}" StrokeThickness="3"
                            StrokeShape="RoundRectangle 20" Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource InkStrongBrush}" Opacity="0.9" Radius="0" Offset="3,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Display Name" FontFamily="KalamBold" FontSize="17" TextColor="{StaticResource InkStrong}" />
                            <controls:BorderedEntry Placeholder="Display name"
                                                     Text="{Binding DisplayName.Value}"
                                                     Errors="{Binding DisplayName.Errors}" />
                            <Label Text="Saved!" FontFamily="PatrickHandRegular" FontSize="14"
                                   TextColor="{StaticResource Success}" IsVisible="{Binding NameSaved}" />
                            <Button Text="Save Name" Command="{Binding SaveNameCommand}"
                                    FontFamily="PatrickHandRegular" FontSize="16"
                                    BackgroundColor="{StaticResource AccentStrong}" TextColor="{StaticResource OnAccentStrong}"
                                    BorderColor="{StaticResource InkStrong}" BorderWidth="2" CornerRadius="12" HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>

                    <!--Change Password-->
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource InkStrong}" StrokeThickness="3"
                            StrokeShape="RoundRectangle 20" Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource InkStrongBrush}" Opacity="0.9" Radius="0" Offset="3,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Change Password" FontFamily="KalamBold" FontSize="17" TextColor="{StaticResource InkStrong}" />
                            <controls:BorderedEntry Placeholder="Current password" IsPassword="True"
                                                     Text="{Binding CurrentPassword}" />
                            <controls:BorderedEntry Placeholder="New password" IsPassword="True"
                                                     Text="{Binding NewPassword}" />
                            <controls:BorderedEntry Placeholder="Confirm new password" IsPassword="True"
                                                     Text="{Binding ConfirmPassword}" />
                            <Label Text="{Binding PasswordError}" FontFamily="PatrickHandRegular" FontSize="14"
                                   TextColor="{StaticResource Error}" IsVisible="{Binding HasPasswordError}" />
                            <Label Text="Password updated!" FontFamily="PatrickHandRegular" FontSize="14"
                                   TextColor="{StaticResource Success}" IsVisible="{Binding PasswordSaved}" />
                            <Button Text="Update Password" Command="{Binding ChangePasswordCommand}"
                                    FontFamily="PatrickHandRegular" FontSize="16"
                                    BackgroundColor="{StaticResource AccentStrong}" TextColor="{StaticResource OnAccentStrong}"
                                    BorderColor="{StaticResource InkStrong}" BorderWidth="2" CornerRadius="12" HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!--Avatar picker bottom sheet-->
            <Grid IsVisible="{Binding IsAvatarPickerVisible}" BackgroundColor="{StaticResource OverlayScrim}">
                <Border x:Name="AvatarSheet" VerticalOptions="End" BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource InkStrong}" StrokeThickness="3" Padding="22,24,22,30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22,22,0,0" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">

                        <Label Text="Choose Your Avatar" FontFamily="KalamBold" FontSize="20" TextColor="{StaticResource InkStrong}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="110">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" Padding="0"
                                    StrokeShape="RoundRectangle 22" Stroke="{StaticResource InkStrong}" StrokeThickness="2"
                                    BackgroundColor="{StaticResource SurfaceAlt}" VerticalOptions="Center">
                                <Path Data="M15 18l-6-6 6-6"
                                     Stroke="{StaticResource InkStrong}"
                                     StrokeThickness="2"
                                     Aspect="Uniform"
                                     WidthRequest="18"
                                     HeightRequest="18"
                                     StrokeLineCap="Round"
                                     StrokeLineJoin="Round"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="PreviousTap" Tapped="PreviousTap_OnTapped"></TapGestureRecognizer>
                                </Border.GestureRecognizers>
                            </Border>
                            <CarouselView Grid.Column="1"
                               x:Name="AvatarView"
                               ItemsSource="{Binding Avatars}"
                               CurrentItem="{Binding Avatar,Mode=TwoWay}"
                               HeightRequest="110"
                               Loop="True"
                               CurrentItemChanged="CarouselView_OnCurrentItemChanged">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Avatar">
                                        <ContentView>
                                            <svg:SvgImage
                                               Aspect="Fit"
                                               Margin="8"
                                               HeightRequest="80"
                                               Scale="{Binding Scale}"
                                               Source="{Binding Name}" />
                                        </ContentView>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" Padding="0"
                                    StrokeShape="RoundRectangle 22" Stroke="{StaticResource InkStrong}" StrokeThickness="2"
                                    BackgroundColor="{StaticResource SurfaceAlt}" VerticalOptions="Center">
                                <Path Data="M9 18l6-6-6-6"
                                     Stroke="{StaticResource InkStrong}"
                                     StrokeThickness="2"
                                     Aspect="Uniform"
                                     WidthRequest="18"
                                     HeightRequest="18"
                                     StrokeLineCap="Round"
                                     StrokeLineJoin="Round"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="NextTap" Tapped="NextTap_OnTapped"></TapGestureRecognizer>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource InkStrong}" StrokeThickness="2"
                                StrokeShape="RoundRectangle 12" HeightRequest="44" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AvatarSelectedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Done" FontFamily="PatrickHandRegular" FontSize="16" TextColor="{StaticResource InkStrong}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>
