		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.10.3" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Picator.Realtime.Common\Picator.Realtime.Common.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<ProjectReference Include="..\QrGenerator.Binding\QrGenerator.Binding.csproj" />
