{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "DbPassword": {
      "type": "parameter.v0",
      "value": "{DbPassword.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "sql": {
      "type": "container.v0",
      "connectionString": "Server={sql.bindings.tcp.host},{sql.bindings.tcp.port};User ID=sa;Password={DbPassword.value};TrustServerCertificate=true",
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "volumes": [
        {
          "name": "picator.apphost-9c6ec4149d-sql-data",
          "target": "/var/opt/mssql",
          "readOnly": false
        }
      ],
      "env": {
        "ACCEPT_EULA": "Y",
        "MSSQL_SA_PASSWORD": "{DbPassword.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1433
        }
      }
    },
    "PicatorDB": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=PicatorDB"
    },
    "picator-api": {
      "type": "project.v0",
      "path": "../Picator.Api/Picator.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{picator-api.bindings.http.targetPort}",
        "ConnectionStrings__PicatorDB": "{PicatorDB.connectionString}",
        "PICATORDB_HOST": "{sql.bindings.tcp.host}",
        "PICATORDB_PORT": "{sql.bindings.tcp.port}",
        "PICATORDB_USERNAME": "sa",
        "PICATORDB_PASSWORD": "{DbPassword.value}",
        "PICATORDB_URI": "mssql://{sql.bindings.tcp.host}:{sql.bindings.tcp.port}/PicatorDB",
        "PICATORDB_JDBCCONNECTIONSTRING": "jdbc:sqlserver://{sql.bindings.tcp.host}:{sql.bindings.tcp.port};trustServerCertificate=true;databaseName=PicatorDB",
        "PICATORDB_DATABASE": "PicatorDB"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "picator-realtime": {
      "type": "project.v0",
      "path": "../Picator.Realtime/Picator.Realtime.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{picator-realtime.bindings.http.targetPort}",
        "ConnectionStrings__PicatorDB": "{PicatorDB.connectionString}",
        "PICATORDB_HOST": "{sql.bindings.tcp.host}",
        "PICATORDB_PORT": "{sql.bindings.tcp.port}",
        "PICATORDB_USERNAME": "sa",
        "PICATORDB_PASSWORD": "{DbPassword.value}",
        "PICATORDB_URI": "mssql://{sql.bindings.tcp.host}:{sql.bindings.tcp.port}/PicatorDB",
        "PICATORDB_JDBCCONNECTIONSTRING": "jdbc:sqlserver://{sql.bindings.tcp.host}:{sql.bindings.tcp.port};trustServerCertificate=true;databaseName=PicatorDB",
        "PICATORDB_DATABASE": "PicatorDB"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2"
        }
      }
    },
    "picator-externalauth": {
      "type": "project.v0",
      "path": "../Picator.ExternalAuth/Picator.ExternalAuth.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{picator-externalauth.bindings.http.targetPort}",
        "ConnectionStrings__PicatorDB": "{PicatorDB.connectionString}",
        "PICATORDB_HOST": "{sql.bindings.tcp.host}",
        "PICATORDB_PORT": "{sql.bindings.tcp.port}",
        "PICATORDB_USERNAME": "sa",
        "PICATORDB_PASSWORD": "{DbPassword.value}",
        "PICATORDB_URI": "mssql://{sql.bindings.tcp.host}:{sql.bindings.tcp.port}/PicatorDB",
        "PICATORDB_JDBCCONNECTIONSTRING": "jdbc:sqlserver://{sql.bindings.tcp.host}:{sql.bindings.tcp.port};trustServerCertificate=true;databaseName=PicatorDB",
        "PICATORDB_DATABASE": "PicatorDB"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "tempapitest": {
      "type": "project.v0",
      "path": "../TempAPITest/TempAPITest.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{tempapitest.bindings.http.targetPort}",
        "PICATOR-API_HTTP": "{picator-api.bindings.http.url}",
        "services__picator-api__http__0": "{picator-api.bindings.http.url}",
        "PICATOR-API_HTTPS": "{picator-api.bindings.https.url}",
        "services__picator-api__https__0": "{picator-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "picator-invitement": {
      "type": "project.v0",
      "path": "../Picator.Invitement/Picator.Invitement/Picator.Invitement.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{picator-invitement.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    }
  }
}