{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run: App + Aspire",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run-app.sh",
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Stop: App + Aspire",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/stop-app.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
